# Copy to .env and fill in. These are read from the process environment, not auto-loaded —
# export them in your shell or set them in your MCP client config.

# Implementation-side (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Scrutiny-side (Anthropic) — a different provider to reduce self-review bias
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Where generated design/code/tests are written
ORCHESTRATOR_WORKSPACE=

# Front-loaded approvals (minimize human touch)
APPROVE_FILE_WRITES=true
APPROVE_GIT_COMMIT=true
APPROVE_GIT_PUSH=false
APPROVE_MODEL_CALLS=true
MAX_DESIGN_ITERATIONS=3
MAX_CODE_ITERATIONS=4
