# Build artifacts / caches (keep the cloud build context small and reproducible)
**/target/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/

# VCS / IDE / OS cruft
**/.git/
**/.gitignore
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db

# Logs and scratch
**/*.log
learning-hub/judge/build_all.log

# Node (if any tooling ever added it)
**/node_modules/

# Orchestrator: ship src + docs + pom + README (shown in the app); exclude build/scratch/secrets
coding-orchestrator/target/
coding-orchestrator/.env
coding-orchestrator/.env.*
coding-orchestrator/plan.md
coding-orchestrator/dependency-reduced-pom.xml

# The Dockerfile itself and this ignore file don't need to ship
Dockerfile
.dockerignore
