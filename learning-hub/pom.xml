<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================================
  learning-hub/pom.xml
  ============================================================================================
  A minimalist Spring Boot web app that serves the study material in this Projects folder:
    * Spring Boot demo  (spring-crud-demo/)
    * LLD solutions      (parking-lot/, chess/, ... 21 problems)
    * HLD write-ups      (system-design-hld/*.md)
  It exposes a small REST API (file tree + file content) and a static single-page frontend
  that renders Markdown (with Mermaid diagrams) and source code (syntax highlighted).

  Only two runtime concerns: spring-boot-starter-web (REST API + embedded Tomcat + static
  resource serving) and the test starter. No database — content is read from disk.
  ============================================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>learning-hub</artifactId>
    <version>1.0.0</version>
    <name>learning-hub</name>
    <description>A minimalist Spring Boot app to browse and read the SpringBoot/LLD/HLD study material</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Spring MVC + embedded Tomcat + Jackson JSON + static resource handling. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Azure Tables SDK — persists per-user problem-completion progress in an Azure Storage
             Table (cheap, ~pennies/month) so progress syncs across devices. When no connection
             string is configured the ProgressService falls back to an in-memory store. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-data-tables</artifactId>
            <version>12.4.5</version>
        </dependency>

        <!-- Generates metadata for our @ConfigurationProperties so the IDE can auto-complete
             them in application.yml. 'optional' so it never leaks onto downstream classpaths. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JUnit 5 + Spring Test + MockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
