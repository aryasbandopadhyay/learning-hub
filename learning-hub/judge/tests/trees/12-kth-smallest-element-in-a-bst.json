{
  "id": "trees/12-kth-smallest-element-in-a-bst",
  "note": "kthSmallest(root, k): trees must be valid BSTs.",
  "cases": [
    {
      "label": "classic k=1",
      "args": [
        [
          3,
          1,
          4,
          null,
          2
        ],
        1
      ],
      "expected": 1
    },
    {
      "label": "classic k=3",
      "args": [
        [
          5,
          3,
          6,
          2,
          4,
          null,
          null,
          1
        ],
        3
      ],
      "expected": 3
    },
    {
      "label": "single node",
      "args": [
        [
          1
        ],
        1
      ],
      "expected": 1
    },
    {
      "label": "k equals size",
      "args": [
        [
          2,
          1,
          3
        ],
        3
      ],
      "expected": 3
    },
    {
      "label": "middle element",
      "args": [
        [
          4,
          2,
          6,
          1,
          3,
          5,
          7
        ],
        4
      ],
      "expected": 4
    },
    {
      "label": "smallest in left chain",
      "args": [
        [
          3,
          2,
          null,
          1
        ],
        1
      ],
      "expected": 1
    },
    {
      "label": "largest",
      "args": [
        [
          3,
          2,
          null,
          1
        ],
        3
      ],
      "expected": 3
    }
  ]
}