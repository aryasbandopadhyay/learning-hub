{
  "id": "trees/01-invert-binary-tree",
  "note": "invertTree(root): tree given as LeetCode level-order array with nulls.",
  "cases": [
    {
      "label": "classic",
      "args": [
        [
          4,
          2,
          7,
          1,
          3,
          6,
          9
        ]
      ],
      "expected": [
        4,
        7,
        2,
        9,
        6,
        3,
        1
      ]
    },
    {
      "label": "small",
      "args": [
        [
          2,
          1,
          3
        ]
      ],
      "expected": [
        2,
        3,
        1
      ]
    },
    {
      "label": "single node",
      "args": [
        [
          1
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "label": "empty tree",
      "args": [
        []
      ],
      "expected": null
    },
    {
      "label": "left skewed",
      "args": [
        [
          1,
          2,
          null,
          3
        ]
      ],
      "expected": [
        1,
        null,
        2,
        null,
        3
      ]
    },
    {
      "label": "right skewed",
      "args": [
        [
          1,
          null,
          2,
          null,
          3
        ]
      ],
      "expected": [
        1,
        2,
        null,
        3
      ]
    },
    {
      "label": "sparse",
      "args": [
        [
          1,
          2,
          3,
          null,
          4,
          null,
          5
        ]
      ],
      "expected": [
        1,
        3,
        2,
        5,
        null,
        4
      ]
    }
  ]
}