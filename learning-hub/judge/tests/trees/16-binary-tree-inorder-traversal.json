{
  "id": "trees/16-binary-tree-inorder-traversal",
  "note": "inorderTraversal(root): list of values left-root-right.",
  "cases": [
    {
      "label": "classic",
      "args": [
        [
          1,
          null,
          2,
          3
        ]
      ],
      "expected": [
        1,
        3,
        2
      ]
    },
    {
      "label": "single node",
      "args": [
        [
          1
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "label": "empty tree",
      "args": [
        []
      ],
      "expected": []
    },
    {
      "label": "balanced",
      "args": [
        [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ]
      ],
      "expected": [
        4,
        2,
        5,
        1,
        6,
        3,
        7
      ]
    },
    {
      "label": "left skewed",
      "args": [
        [
          3,
          2,
          null,
          1
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "right skewed",
      "args": [
        [
          1,
          null,
          2,
          null,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    }
  ]
}