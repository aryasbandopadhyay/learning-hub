{
  "id": "trees/17-binary-tree-preorder-traversal",
  "note": "preorderTraversal(root): root-left-right.",
  "cases": [
    {
      "label": "classic",
      "args": [
        [
          1,
          null,
          2,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "single node",
      "args": [
        [
          1
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "label": "empty tree",
      "args": [
        []
      ],
      "expected": []
    },
    {
      "label": "balanced",
      "args": [
        [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ]
      ],
      "expected": [
        1,
        2,
        4,
        5,
        3,
        6,
        7
      ]
    },
    {
      "label": "left skewed",
      "args": [
        [
          3,
          2,
          null,
          1
        ]
      ],
      "expected": [
        3,
        2,
        1
      ]
    },
    {
      "label": "sparse",
      "args": [
        [
          1,
          2,
          3,
          null,
          4
        ]
      ],
      "expected": [
        1,
        2,
        4,
        3
      ]
    }
  ]
}