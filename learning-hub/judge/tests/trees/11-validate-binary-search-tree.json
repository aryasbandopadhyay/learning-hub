{
  "id": "trees/11-validate-binary-search-tree",
  "note": "isValidBST(root): boolean.",
  "cases": [
    {
      "label": "valid small",
      "args": [
        [
          2,
          1,
          3
        ]
      ],
      "expected": true
    },
    {
      "label": "invalid root",
      "args": [
        [
          5,
          1,
          4,
          null,
          null,
          3,
          6
        ]
      ],
      "expected": false
    },
    {
      "label": "single node",
      "args": [
        [
          1
        ]
      ],
      "expected": true
    },
    {
      "label": "empty tree",
      "args": [
        []
      ],
      "expected": true
    },
    {
      "label": "valid larger",
      "args": [
        [
          5,
          3,
          8,
          2,
          4,
          7,
          9
        ]
      ],
      "expected": true
    },
    {
      "label": "invalid subtle (right subtree)",
      "args": [
        [
          3,
          1,
          5,
          null,
          null,
          2,
          6
        ]
      ],
      "expected": false
    },
    {
      "label": "valid left skewed",
      "args": [
        [
          3,
          2,
          null,
          1
        ]
      ],
      "expected": true
    }
  ]
}