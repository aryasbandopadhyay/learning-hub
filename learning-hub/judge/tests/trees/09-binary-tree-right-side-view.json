{
  "id": "trees/09-binary-tree-right-side-view",
  "note": "rightSideView(root): rightmost node per level, top to bottom.",
  "cases": [
    {
      "label": "classic",
      "args": [
        [
          1,
          2,
          3,
          null,
          5,
          null,
          4
        ]
      ],
      "expected": [
        1,
        3,
        4
      ]
    },
    {
      "label": "single node",
      "args": [
        [
          1
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "label": "empty tree",
      "args": [
        []
      ],
      "expected": []
    },
    {
      "label": "left skewed",
      "args": [
        [
          1,
          2,
          null,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "right skewed",
      "args": [
        [
          1,
          null,
          2,
          null,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "balanced",
      "args": [
        [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ]
      ],
      "expected": [
        1,
        3,
        7
      ]
    },
    {
      "label": "deep left visible",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": [
        1,
        3,
        4
      ]
    }
  ]
}