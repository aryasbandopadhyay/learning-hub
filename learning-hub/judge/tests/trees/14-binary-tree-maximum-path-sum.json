{
  "id": "trees/14-binary-tree-maximum-path-sum",
  "note": "maxPathSum(root): any node-to-node path.",
  "cases": [
    {
      "label": "classic",
      "args": [
        [
          -10,
          9,
          20,
          null,
          null,
          15,
          7
        ]
      ],
      "expected": 42
    },
    {
      "label": "small",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": 6
    },
    {
      "label": "single node",
      "args": [
        [
          5
        ]
      ],
      "expected": 5
    },
    {
      "label": "single negative node",
      "args": [
        [
          -3
        ]
      ],
      "expected": -3
    },
    {
      "label": "all negative",
      "args": [
        [
          -1,
          -2,
          -3
        ]
      ],
      "expected": -1
    },
    {
      "label": "path avoids negative child",
      "args": [
        [
          2,
          -1,
          3
        ]
      ],
      "expected": 5
    },
    {
      "label": "balanced positive",
      "args": [
        [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ]
      ],
      "expected": 18
    }
  ]
}