{
  "id": "bit-manipulation/05-missing-number",
  "cases": [
    {
      "label": "example",
      "args": [
        [
          3,
          0,
          1
        ]
      ],
      "expected": 2
    },
    {
      "label": "missing zero",
      "args": [
        [
          1
        ]
      ],
      "expected": 0
    },
    {
      "label": "missing last",
      "args": [
        [
          0,
          1,
          2
        ]
      ],
      "expected": 3
    },
    {
      "label": "single missing one",
      "args": [
        [
          0
        ]
      ],
      "expected": 1
    },
    {
      "label": "larger",
      "args": [
        [
          9,
          6,
          4,
          2,
          3,
          5,
          7,
          0,
          1
        ]
      ],
      "expected": 8
    }
  ]
}