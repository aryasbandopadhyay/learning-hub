{
  "id": "matrix/09-diagonal-traverse",
  "cases": [
    {
      "label": "example",
      "args": [
        [
          [
            1,
            2,
            3
          ],
          [
            4,
            5,
            6
          ],
          [
            7,
            8,
            9
          ]
        ]
      ],
      "expected": [
        1,
        2,
        4,
        7,
        5,
        3,
        6,
        8,
        9
      ]
    },
    {
      "label": "single",
      "args": [
        [
          [
            1
          ]
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "label": "single row",
      "args": [
        [
          [
            1,
            2,
            3
          ]
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "single col",
      "args": [
        [
          [
            1
          ],
          [
            2
          ],
          [
            3
          ]
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "2x2",
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ]
      ],
      "expected": [
        1,
        2,
        3,
        4
      ]
    }
  ]
}