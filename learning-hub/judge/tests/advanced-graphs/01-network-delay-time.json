{
  "id": "advanced-graphs/01-network-delay-time",
  "cases": [
    {
      "label": "example",
      "args": [
        [
          [
            2,
            1,
            1
          ],
          [
            2,
            3,
            1
          ],
          [
            3,
            4,
            1
          ]
        ],
        4,
        2
      ],
      "expected": 2
    },
    {
      "label": "unreachable",
      "args": [
        [
          [
            1,
            2,
            1
          ]
        ],
        3,
        1
      ],
      "expected": -1
    },
    {
      "label": "single node",
      "args": [
        [],
        1,
        1
      ],
      "expected": 0
    },
    {
      "label": "two nodes",
      "args": [
        [
          [
            1,
            2,
            5
          ]
        ],
        2,
        1
      ],
      "expected": 5
    },
    {
      "label": "direct all",
      "args": [
        [
          [
            1,
            2,
            1
          ],
          [
            1,
            3,
            2
          ]
        ],
        3,
        1
      ],
      "expected": 2
    }
  ]
}