{
  "id": "arrays-hashing/16-move-zeroes",
  "note": "In-place; preserve relative order of non-zero elements.",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          0,
          1,
          0,
          3,
          12
        ]
      ],
      "expected": [
        1,
        3,
        12,
        0,
        0
      ]
    },
    {
      "label": "no zeros",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "all zeros",
      "args": [
        [
          0,
          0,
          0
        ]
      ],
      "expected": [
        0,
        0,
        0
      ]
    },
    {
      "label": "single zero",
      "args": [
        [
          0
        ]
      ],
      "expected": [
        0
      ]
    },
    {
      "label": "single non-zero",
      "args": [
        [
          7
        ]
      ],
      "expected": [
        7
      ]
    },
    {
      "label": "leading zeros",
      "args": [
        [
          0,
          0,
          5,
          6
        ]
      ],
      "expected": [
        5,
        6,
        0,
        0
      ]
    },
    {
      "label": "negatives preserved in order",
      "args": [
        [
          0,
          -1,
          0,
          -2,
          3
        ]
      ],
      "expected": [
        -1,
        -2,
        3,
        0,
        0
      ]
    },
    {
      "label": "trailing zeros already in place",
      "args": [
        [
          1,
          2,
          0,
          0
        ]
      ],
      "expected": [
        1,
        2,
        0,
        0
      ]
    }
  ]
}