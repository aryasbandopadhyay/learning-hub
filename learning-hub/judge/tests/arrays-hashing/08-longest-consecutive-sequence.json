{
  "id": "arrays-hashing/08-longest-consecutive-sequence",
  "cases": [
    {
      "label": "empty array",
      "args": [
        []
      ],
      "expected": 0
    },
    {
      "label": "single element",
      "args": [
        [
          42
        ]
      ],
      "expected": 1
    },
    {
      "label": "classic unordered run",
      "args": [
        [
          100,
          4,
          200,
          1,
          3,
          2
        ]
      ],
      "expected": 4
    },
    {
      "label": "duplicates should not extend the run",
      "args": [
        [
          1,
          2,
          2,
          3
        ]
      ],
      "expected": 3
    },
    {
      "label": "negatives and positives form one run",
      "args": [
        [
          -2,
          -1,
          0,
          1,
          2
        ]
      ],
      "expected": 5
    },
    {
      "label": "no consecutive pair",
      "args": [
        [
          10,
          30,
          50,
          70
        ]
      ],
      "expected": 1
    },
    {
      "label": "already sorted long run",
      "args": [
        [
          5,
          6,
          7,
          8,
          9,
          10
        ]
      ],
      "expected": 6
    },
    {
      "label": "two separate runs",
      "args": [
        [
          1,
          2,
          3,
          100,
          101
        ]
      ],
      "expected": 3
    }
  ]
}