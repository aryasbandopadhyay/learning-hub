{
  "id": "arrays-hashing/19-find-the-duplicate-number",
  "note": "n+1 integers each in [1, n]; exactly one value is repeated (possibly many times).",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          1,
          3,
          4,
          2,
          2
        ]
      ],
      "expected": 2
    },
    {
      "label": "duplicate appears many times",
      "args": [
        [
          3,
          1,
          3,
          4,
          2
        ]
      ],
      "expected": 3
    },
    {
      "label": "minimal n=1",
      "args": [
        [
          1,
          1
        ]
      ],
      "expected": 1
    },
    {
      "label": "duplicate is the max value",
      "args": [
        [
          1,
          2,
          3,
          3
        ]
      ],
      "expected": 3
    },
    {
      "label": "duplicate is one",
      "args": [
        [
          1,
          1,
          2
        ]
      ],
      "expected": 1
    },
    {
      "label": "repeated value fills most of the array",
      "args": [
        [
          2,
          2,
          2,
          2,
          1
        ]
      ],
      "expected": 2
    }
  ]
}