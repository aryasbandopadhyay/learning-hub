{
  "id": "arrays-hashing/06-product-of-array-except-self",
  "cases": [
    {
      "label": "minimal two elements",
      "args": [
        [
          2,
          3
        ]
      ],
      "expected": [
        3,
        2
      ]
    },
    {
      "label": "classic example",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": [
        24,
        12,
        8,
        6
      ]
    },
    {
      "label": "contains a single zero",
      "args": [
        [
          1,
          2,
          0,
          4
        ]
      ],
      "expected": [
        0,
        0,
        8,
        0
      ]
    },
    {
      "label": "contains two zeros -> all zero",
      "args": [
        [
          0,
          2,
          0,
          4
        ]
      ],
      "expected": [
        0,
        0,
        0,
        0
      ]
    },
    {
      "label": "negatives flip signs",
      "args": [
        [
          -1,
          1,
          -1,
          1
        ]
      ],
      "expected": [
        -1,
        1,
        -1,
        1
      ]
    },
    {
      "label": "all ones",
      "args": [
        [
          1,
          1,
          1,
          1
        ]
      ],
      "expected": [
        1,
        1,
        1,
        1
      ]
    },
    {
      "label": "includes negative and zero",
      "args": [
        [
          -2,
          0,
          3,
          5
        ]
      ],
      "expected": [
        0,
        -30,
        0,
        0
      ]
    }
  ]
}