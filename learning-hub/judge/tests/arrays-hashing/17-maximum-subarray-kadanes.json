{
  "id": "arrays-hashing/17-maximum-subarray-kadanes",
  "cases": [
    {
      "label": "single positive",
      "args": [
        [
          5
        ]
      ],
      "expected": 5
    },
    {
      "label": "single negative",
      "args": [
        [
          -3
        ]
      ],
      "expected": -3
    },
    {
      "label": "classic example",
      "args": [
        [
          -2,
          1,
          -3,
          4,
          -1,
          2,
          1,
          -5,
          4
        ]
      ],
      "expected": 6
    },
    {
      "label": "all negatives -> largest single",
      "args": [
        [
          -8,
          -3,
          -6,
          -2,
          -5
        ]
      ],
      "expected": -2
    },
    {
      "label": "all positives -> whole array",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": 10
    },
    {
      "label": "zeros and negatives",
      "args": [
        [
          0,
          -1,
          0,
          -2,
          0
        ]
      ],
      "expected": 0
    },
    {
      "label": "negative then big positive",
      "args": [
        [
          -10,
          9,
          8
        ]
      ],
      "expected": 17
    }
  ]
}