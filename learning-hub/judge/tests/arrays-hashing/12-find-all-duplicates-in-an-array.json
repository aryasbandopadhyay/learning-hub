{
  "id": "arrays-hashing/12-find-all-duplicates-in-an-array",
  "note": "1 <= a[i] <= n and each integer appears once or twice.",
  "cases": [
    {
      "label": "no duplicates",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": []
    },
    {
      "label": "classic example",
      "args": [
        [
          4,
          3,
          2,
          7,
          8,
          2,
          3,
          1
        ]
      ],
      "expected": [
        2,
        3
      ]
    },
    {
      "label": "single element no dup",
      "args": [
        [
          1
        ]
      ],
      "expected": []
    },
    {
      "label": "every value duplicated",
      "args": [
        [
          1,
          1,
          2,
          2
        ]
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "label": "duplicate at the ends",
      "args": [
        [
          2,
          1,
          3,
          1
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "label": "max value duplicated",
      "args": [
        [
          3,
          3,
          1,
          2
        ]
      ],
      "expected": [
        3
      ]
    }
  ]
}