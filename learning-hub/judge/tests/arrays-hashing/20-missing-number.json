{
  "id": "arrays-hashing/20-missing-number",
  "note": "Distinct integers taken from [0, n] with exactly one missing. args = [nums].",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          3,
          0,
          1
        ]
      ],
      "expected": 2
    },
    {
      "label": "missing zero",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": 0
    },
    {
      "label": "missing the largest n",
      "args": [
        [
          0,
          1,
          2
        ]
      ],
      "expected": 3
    },
    {
      "label": "single element missing 1",
      "args": [
        [
          0
        ]
      ],
      "expected": 1
    },
    {
      "label": "single element missing 0",
      "args": [
        [
          1
        ]
      ],
      "expected": 0
    },
    {
      "label": "missing a middle value",
      "args": [
        [
          0,
          1,
          3,
          4
        ]
      ],
      "expected": 2
    },
    {
      "label": "shuffled",
      "args": [
        [
          9,
          6,
          4,
          2,
          3,
          5,
          7,
          0,
          1
        ]
      ],
      "expected": 8
    }
  ]
}