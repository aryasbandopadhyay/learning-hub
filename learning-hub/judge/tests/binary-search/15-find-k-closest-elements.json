{
  "id": "binary-search/15-find-k-closest-elements",
  "note": "findClosestElements(arr, k, x): k closest to x, ascending. compare=sorted. Inputs chosen so the closest set is unambiguous (avoid symmetric ties).",
  "cases": [
    {
      "label": "classic x inside",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ],
        4,
        3
      ],
      "expected": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "label": "x below range",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ],
        4,
        -1
      ],
      "expected": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "label": "x above range",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ],
        2,
        9
      ],
      "expected": [
        4,
        5
      ]
    },
    {
      "label": "k equals length",
      "args": [
        [
          1,
          3,
          5,
          7
        ],
        4,
        4
      ],
      "expected": [
        1,
        3,
        5,
        7
      ]
    },
    {
      "label": "k=1 nearest",
      "args": [
        [
          1,
          2,
          5,
          8
        ],
        1,
        6
      ],
      "expected": [
        5
      ]
    },
    {
      "label": "x equals element",
      "args": [
        [
          2,
          4,
          6,
          8,
          10
        ],
        3,
        6
      ],
      "expected": [
        4,
        6,
        8
      ]
    },
    {
      "label": "closer to lower side",
      "args": [
        [
          1,
          2,
          3,
          10,
          11
        ],
        3,
        2
      ],
      "expected": [
        1,
        2,
        3
      ]
    }
  ]
}