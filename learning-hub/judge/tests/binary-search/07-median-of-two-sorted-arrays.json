{
  "id": "binary-search/07-median-of-two-sorted-arrays",
  "note": "findMedianSortedArrays(nums1, nums2): float median.",
  "cases": [
    {
      "label": "odd total",
      "args": [
        [
          1,
          3
        ],
        [
          2
        ]
      ],
      "expected": 2.0
    },
    {
      "label": "even total",
      "args": [
        [
          1,
          2
        ],
        [
          3,
          4
        ]
      ],
      "expected": 2.5
    },
    {
      "label": "one empty",
      "args": [
        [],
        [
          1
        ]
      ],
      "expected": 1.0
    },
    {
      "label": "one empty even",
      "args": [
        [
          2,
          3
        ],
        []
      ],
      "expected": 2.5
    },
    {
      "label": "disjoint ranges",
      "args": [
        [
          1,
          2,
          3
        ],
        [
          10,
          11,
          12
        ]
      ],
      "expected": 6.5
    },
    {
      "label": "interleaved",
      "args": [
        [
          1,
          5,
          9
        ],
        [
          2,
          6,
          10
        ]
      ],
      "expected": 5.5
    },
    {
      "label": "single each",
      "args": [
        [
          1
        ],
        [
          2
        ]
      ],
      "expected": 1.5
    }
  ]
}