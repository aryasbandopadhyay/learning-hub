{
  "id": "heap-priority-queue/01-kth-largest-element-in-an-array",
  "cases": [
    {
      "label": "single",
      "args": [
        [
          1
        ],
        1
      ],
      "expected": 1
    },
    {
      "label": "all equal k=2",
      "args": [
        [
          7,
          7,
          7
        ],
        2
      ],
      "expected": 7
    },
    {
      "label": "negatives k=1",
      "args": [
        [
          -1,
          -2,
          -3
        ],
        1
      ],
      "expected": -1
    },
    {
      "label": "two elements min",
      "args": [
        [
          2,
          1
        ],
        2
      ],
      "expected": 1
    },
    {
      "label": "desc k=3",
      "args": [
        [
          5,
          4,
          3,
          2,
          1
        ],
        3
      ],
      "expected": 3
    },
    {
      "label": "asc k=1",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ],
        1
      ],
      "expected": 5
    },
    {
      "label": "dup top k=1",
      "args": [
        [
          3,
          3,
          3,
          3,
          1
        ],
        1
      ],
      "expected": 3
    },
    {
      "label": "mixed dups k=2",
      "args": [
        [
          -1,
          -1,
          -2,
          -2
        ],
        2
      ],
      "expected": -1
    },
    {
      "label": "k=len",
      "args": [
        [
          99,
          50,
          1
        ],
        3
      ],
      "expected": 1
    },
    {
      "label": "larger k=4",
      "args": [
        [
          99,
          99,
          50,
          50,
          1
        ],
        4
      ],
      "expected": 50
    }
  ]
}