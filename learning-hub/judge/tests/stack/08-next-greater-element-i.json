{
  "id": "stack/08-next-greater-element-i",
  "note": "nextGreaterElement(nums1, nums2): nums1 is a subset of nums2.",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          4,
          1,
          2
        ],
        [
          1,
          3,
          4,
          2
        ]
      ],
      "expected": [
        -1,
        3,
        -1
      ]
    },
    {
      "label": "second example",
      "args": [
        [
          2,
          4
        ],
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": [
        3,
        -1
      ]
    },
    {
      "label": "largest has none",
      "args": [
        [
          4
        ],
        [
          4,
          3,
          2,
          1
        ]
      ],
      "expected": [
        -1
      ]
    },
    {
      "label": "all have next greater",
      "args": [
        [
          1,
          2,
          3
        ],
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": [
        2,
        3,
        4
      ]
    },
    {
      "label": "single element",
      "args": [
        [
          1
        ],
        [
          1
        ]
      ],
      "expected": [
        -1
      ]
    },
    {
      "label": "reverse-sorted nums2",
      "args": [
        [
          3,
          1
        ],
        [
          5,
          4,
          3,
          2,
          1
        ]
      ],
      "expected": [
        -1,
        -1
      ]
    }
  ]
}