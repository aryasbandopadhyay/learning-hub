{
  "id": "greedy/04-hand-of-straights",
  "cases": [
    {
      "label": "example",
      "args": [
        [
          1,
          2,
          3,
          6,
          2,
          3,
          4,
          7,
          8
        ],
        3
      ],
      "expected": true
    },
    {
      "label": "not divisible",
      "args": [
        [
          1,
          2,
          3,
          4
        ],
        3
      ],
      "expected": false
    },
    {
      "label": "group size 1",
      "args": [
        [
          1,
          2,
          3
        ],
        1
      ],
      "expected": true
    },
    {
      "label": "cannot form",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ],
        4
      ],
      "expected": false
    },
    {
      "label": "single group",
      "args": [
        [
          1,
          2,
          3
        ],
        3
      ],
      "expected": true
    }
  ]
}