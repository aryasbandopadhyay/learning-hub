{
  "id": "sliding-window/15-grumpy-bookstore-owner",
  "note": "maxSatisfied(customers, grumpy, minutes): max satisfied customers using one 'minutes'-long calm window.",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          1,
          0,
          1,
          2,
          1,
          1,
          7,
          5
        ],
        [
          0,
          1,
          0,
          1,
          0,
          1,
          0,
          1
        ],
        3
      ],
      "expected": 16
    },
    {
      "label": "single minute window",
      "args": [
        [
          4,
          10,
          10
        ],
        [
          1,
          1,
          0
        ],
        1
      ],
      "expected": 20
    },
    {
      "label": "never grumpy",
      "args": [
        [
          3,
          3,
          3
        ],
        [
          0,
          0,
          0
        ],
        2
      ],
      "expected": 9
    },
    {
      "label": "always grumpy, window covers all",
      "args": [
        [
          2,
          2,
          2
        ],
        [
          1,
          1,
          1
        ],
        3
      ],
      "expected": 6
    },
    {
      "label": "window size 1",
      "args": [
        [
          1,
          2,
          3,
          4
        ],
        [
          1,
          0,
          1,
          0
        ],
        1
      ],
      "expected": 9
    },
    {
      "label": "single customer grumpy",
      "args": [
        [
          5
        ],
        [
          1
        ],
        1
      ],
      "expected": 5
    },
    {
      "label": "window at the end",
      "args": [
        [
          1,
          1,
          1,
          10,
          10
        ],
        [
          0,
          0,
          0,
          1,
          1
        ],
        2
      ],
      "expected": 23
    }
  ]
}