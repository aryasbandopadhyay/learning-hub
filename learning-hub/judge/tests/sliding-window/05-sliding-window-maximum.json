{
  "id": "sliding-window/05-sliding-window-maximum",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          1,
          3,
          -1,
          -3,
          5,
          3,
          6,
          7
        ],
        3
      ],
      "expected": [
        3,
        3,
        5,
        5,
        6,
        7
      ]
    },
    {
      "label": "window size 1",
      "args": [
        [
          4,
          2,
          12,
          3
        ],
        1
      ],
      "expected": [
        4,
        2,
        12,
        3
      ]
    },
    {
      "label": "window equals length",
      "args": [
        [
          2,
          1,
          5
        ],
        3
      ],
      "expected": [
        5
      ]
    },
    {
      "label": "single element",
      "args": [
        [
          9
        ],
        1
      ],
      "expected": [
        9
      ]
    },
    {
      "label": "decreasing",
      "args": [
        [
          5,
          4,
          3,
          2,
          1
        ],
        2
      ],
      "expected": [
        5,
        4,
        3,
        2
      ]
    },
    {
      "label": "increasing",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ],
        2
      ],
      "expected": [
        2,
        3,
        4,
        5
      ]
    },
    {
      "label": "negatives",
      "args": [
        [
          -7,
          -8,
          -3,
          -1,
          -9
        ],
        2
      ],
      "expected": [
        -7,
        -3,
        -1,
        -1
      ]
    },
    {
      "label": "duplicates",
      "args": [
        [
          3,
          3,
          3,
          3
        ],
        2
      ],
      "expected": [
        3,
        3,
        3
      ]
    }
  ]
}