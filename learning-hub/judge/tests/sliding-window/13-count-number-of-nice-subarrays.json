{
  "id": "sliding-window/13-count-number-of-nice-subarrays",
  "note": "numberOfSubarrays(nums, k): count subarrays with exactly k odd numbers.",
  "cases": [
    {
      "label": "classic [1,1,2,1,1] k=3",
      "args": [
        [
          1,
          1,
          2,
          1,
          1
        ],
        3
      ],
      "expected": 2
    },
    {
      "label": "classic [2,4,6] k=1",
      "args": [
        [
          2,
          4,
          6
        ],
        1
      ],
      "expected": 0
    },
    {
      "label": "classic [2,2,2,1,2,2,1,2,2,2] k=2",
      "args": [
        [
          2,
          2,
          2,
          1,
          2,
          2,
          1,
          2,
          2,
          2
        ],
        2
      ],
      "expected": 16
    },
    {
      "label": "single odd k=1",
      "args": [
        [
          1
        ],
        1
      ],
      "expected": 1
    },
    {
      "label": "single even k=1 -> 0",
      "args": [
        [
          2
        ],
        1
      ],
      "expected": 0
    },
    {
      "label": "all odd",
      "args": [
        [
          1,
          1,
          1
        ],
        2
      ],
      "expected": 2
    }
  ]
}