{
  "id": "sliding-window/12-maximum-average-subarray-i",
  "note": "findMaxAverage(nums, k): max average of any length-k contiguous subarray (float).",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          1,
          12,
          -5,
          -6,
          50,
          3
        ],
        4
      ],
      "expected": 12.75
    },
    {
      "label": "k equals length",
      "args": [
        [
          5,
          5,
          5
        ],
        3
      ],
      "expected": 5.0
    },
    {
      "label": "k=1 picks max",
      "args": [
        [
          -1,
          -2,
          -3,
          8
        ],
        1
      ],
      "expected": 8.0
    },
    {
      "label": "all negatives",
      "args": [
        [
          -4,
          -2,
          -6,
          -1
        ],
        2
      ],
      "expected": -3.0
    },
    {
      "label": "single element k=1",
      "args": [
        [
          7
        ],
        1
      ],
      "expected": 7.0
    },
    {
      "label": "mixed signs",
      "args": [
        [
          0,
          4,
          0,
          3,
          2
        ],
        2
      ],
      "expected": 2.5
    },
    {
      "label": "all equal",
      "args": [
        [
          3,
          3,
          3,
          3
        ],
        2
      ],
      "expected": 3.0
    }
  ]
}