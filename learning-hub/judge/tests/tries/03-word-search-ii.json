{
  "id": "tries/03-word-search-ii",
  "note": "findWords(board, words): words found in the grid. compare=sorted (order-independent).",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          [
            "o",
            "a",
            "a",
            "n"
          ],
          [
            "e",
            "t",
            "a",
            "e"
          ],
          [
            "i",
            "h",
            "k",
            "r"
          ],
          [
            "i",
            "f",
            "l",
            "v"
          ]
        ],
        [
          "oath",
          "pea",
          "eat",
          "rain"
        ]
      ],
      "expected": [
        "oath",
        "eat"
      ]
    },
    {
      "label": "none found",
      "args": [
        [
          [
            "a",
            "b"
          ],
          [
            "c",
            "d"
          ]
        ],
        [
          "xyz",
          "efg"
        ]
      ],
      "expected": []
    },
    {
      "label": "single cell match",
      "args": [
        [
          [
            "a"
          ]
        ],
        [
          "a",
          "b"
        ]
      ],
      "expected": [
        "a"
      ]
    },
    {
      "label": "simple two-letter",
      "args": [
        [
          [
            "a",
            "b"
          ],
          [
            "c",
            "d"
          ]
        ],
        [
          "ab",
          "cd",
          "ac",
          "bd"
        ]
      ],
      "expected": [
        "ac",
        "ab",
        "bd",
        "cd"
      ]
    },
    {
      "label": "no reuse of cell",
      "args": [
        [
          [
            "a",
            "a"
          ]
        ],
        [
          "aaa",
          "aa"
        ]
      ],
      "expected": [
        "aa"
      ]
    },
    {
      "label": "word longer than board",
      "args": [
        [
          [
            "a",
            "b"
          ],
          [
            "c",
            "d"
          ]
        ],
        [
          "abcd",
          "abdc"
        ]
      ],
      "expected": [
        "abdc"
      ]
    }
  ]
}