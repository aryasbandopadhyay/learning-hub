{
  "id": "tries/06-longest-word-in-dictionary",
  "note": "longestWord(words): longest word buildable one char at a time; ties -> lexicographically smallest.",
  "cases": [
    {
      "label": "single chain",
      "args": [
        [
          "w",
          "wo",
          "wor",
          "worl",
          "world"
        ]
      ],
      "expected": "world"
    },
    {
      "label": "tie broken lexicographically",
      "args": [
        [
          "a",
          "banana",
          "app",
          "appl",
          "ap",
          "apply",
          "apple"
        ]
      ],
      "expected": "apple"
    },
    {
      "label": "no buildable word",
      "args": [
        [
          "abc",
          "bc",
          "c"
        ]
      ],
      "expected": "c"
    },
    {
      "label": "single letters",
      "args": [
        [
          "a",
          "b",
          "c"
        ]
      ],
      "expected": "a"
    },
    {
      "label": "two independent chains",
      "args": [
        [
          "m",
          "mo",
          "moc",
          "moch",
          "mocha",
          "l",
          "la",
          "lat",
          "latt",
          "latte"
        ]
      ],
      "expected": "latte"
    },
    {
      "label": "one word only",
      "args": [
        [
          "x"
        ]
      ],
      "expected": "x"
    },
    {
      "label": "missing intermediate",
      "args": [
        [
          "t",
          "ti",
          "tig",
          "tige",
          "tiger",
          "z"
        ]
      ],
      "expected": "tiger"
    }
  ]
}