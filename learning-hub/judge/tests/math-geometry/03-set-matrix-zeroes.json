{
  "id": "math-geometry/03-set-matrix-zeroes",
  "cases": [
    {
      "label": "example",
      "args": [
        [
          [
            1,
            1,
            1
          ],
          [
            1,
            0,
            1
          ],
          [
            1,
            1,
            1
          ]
        ]
      ],
      "expected": [
        [
          1,
          0,
          1
        ],
        [
          0,
          0,
          0
        ],
        [
          1,
          0,
          1
        ]
      ]
    },
    {
      "label": "no zeros",
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ]
      ],
      "expected": [
        [
          1,
          2
        ],
        [
          3,
          4
        ]
      ]
    },
    {
      "label": "all zeros",
      "args": [
        [
          [
            0,
            0
          ],
          [
            0,
            0
          ]
        ]
      ],
      "expected": [
        [
          0,
          0
        ],
        [
          0,
          0
        ]
      ]
    },
    {
      "label": "corner zero",
      "args": [
        [
          [
            0,
            1
          ],
          [
            1,
            1
          ]
        ]
      ],
      "expected": [
        [
          0,
          0
        ],
        [
          0,
          1
        ]
      ]
    },
    {
      "label": "single zero",
      "args": [
        [
          [
            0
          ]
        ]
      ],
      "expected": [
        [
          0
        ]
      ]
    }
  ]
}