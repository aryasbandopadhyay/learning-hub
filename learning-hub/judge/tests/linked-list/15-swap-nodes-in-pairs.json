{
  "id": "linked-list/15-swap-nodes-in-pairs",
  "note": "swapPairs(head).",
  "cases": [
    {
      "label": "even length",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": [
        2,
        1,
        4,
        3
      ]
    },
    {
      "label": "odd length (last stays)",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": [
        2,
        1,
        3
      ]
    },
    {
      "label": "two nodes",
      "args": [
        [
          1,
          2
        ]
      ],
      "expected": [
        2,
        1
      ]
    },
    {
      "label": "single node",
      "args": [
        [
          1
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "label": "empty list",
      "args": [
        []
      ],
      "expected": null
    },
    {
      "label": "six nodes",
      "args": [
        [
          1,
          2,
          3,
          4,
          5,
          6
        ]
      ],
      "expected": [
        2,
        1,
        4,
        3,
        6,
        5
      ]
    }
  ]
}