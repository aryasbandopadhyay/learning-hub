{
  "id": "linked-list/16-rotate-list",
  "note": "rotateRight(head, k): rotate right by k places.",
  "cases": [
    {
      "label": "classic k=2",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ],
        2
      ],
      "expected": [
        4,
        5,
        1,
        2,
        3
      ]
    },
    {
      "label": "k greater than length",
      "args": [
        [
          0,
          1,
          2
        ],
        4
      ],
      "expected": [
        2,
        0,
        1
      ]
    },
    {
      "label": "k multiple of length (no change)",
      "args": [
        [
          1,
          2,
          3
        ],
        3
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "k zero",
      "args": [
        [
          1,
          2,
          3
        ],
        0
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "single node",
      "args": [
        [
          1
        ],
        5
      ],
      "expected": [
        1
      ]
    },
    {
      "label": "empty list",
      "args": [
        [],
        3
      ],
      "expected": null
    },
    {
      "label": "two nodes",
      "args": [
        [
          1,
          2
        ],
        1
      ],
      "expected": [
        2,
        1
      ]
    }
  ]
}