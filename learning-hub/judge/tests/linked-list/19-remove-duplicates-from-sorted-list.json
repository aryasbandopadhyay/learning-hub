{
  "id": "linked-list/19-remove-duplicates-from-sorted-list",
  "note": "deleteDuplicates(head): keep one of each value (sorted list).",
  "cases": [
    {
      "label": "classic",
      "args": [
        [
          1,
          1,
          2,
          3,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "no duplicates",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "all same",
      "args": [
        [
          7,
          7,
          7
        ]
      ],
      "expected": [
        7
      ]
    },
    {
      "label": "single node",
      "args": [
        [
          1
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "label": "empty list",
      "args": [
        []
      ],
      "expected": null
    },
    {
      "label": "duplicates at end",
      "args": [
        [
          1,
          2,
          2
        ]
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "label": "long runs",
      "args": [
        [
          1,
          1,
          1,
          2,
          3,
          3,
          4
        ]
      ],
      "expected": [
        1,
        2,
        3,
        4
      ]
    }
  ]
}