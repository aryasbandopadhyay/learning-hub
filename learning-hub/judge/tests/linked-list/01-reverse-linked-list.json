{
  "id": "linked-list/01-reverse-linked-list",
  "note": "reverseList(head).",
  "cases": [
    {
      "label": "classic",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ]
      ],
      "expected": [
        5,
        4,
        3,
        2,
        1
      ]
    },
    {
      "label": "two nodes",
      "args": [
        [
          1,
          2
        ]
      ],
      "expected": [
        2,
        1
      ]
    },
    {
      "label": "single node",
      "args": [
        [
          7
        ]
      ],
      "expected": [
        7
      ]
    },
    {
      "label": "empty list",
      "args": [
        []
      ],
      "expected": null
    },
    {
      "label": "with duplicates",
      "args": [
        [
          3,
          3,
          1,
          1,
          2
        ]
      ],
      "expected": [
        2,
        1,
        1,
        3,
        3
      ]
    },
    {
      "label": "negatives",
      "args": [
        [
          -1,
          -2,
          -3
        ]
      ],
      "expected": [
        -3,
        -2,
        -1
      ]
    }
  ]
}