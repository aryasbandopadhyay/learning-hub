{
  "id": "linked-list/14-odd-even-linked-list",
  "note": "oddEvenList(head): group odd-indexed nodes then even-indexed (1-based positions).",
  "cases": [
    {
      "label": "classic",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ]
      ],
      "expected": [
        1,
        3,
        5,
        2,
        4
      ]
    },
    {
      "label": "even length",
      "args": [
        [
          2,
          1,
          3,
          5,
          6,
          4,
          7
        ]
      ],
      "expected": [
        2,
        3,
        6,
        7,
        1,
        5,
        4
      ]
    },
    {
      "label": "two nodes",
      "args": [
        [
          1,
          2
        ]
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "label": "single node",
      "args": [
        [
          1
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "label": "empty list",
      "args": [
        []
      ],
      "expected": null
    },
    {
      "label": "four nodes",
      "args": [
        [
          10,
          20,
          30,
          40
        ]
      ],
      "expected": [
        10,
        30,
        20,
        40
      ]
    }
  ]
}