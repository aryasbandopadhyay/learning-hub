    {
      "label": "two negatives",
      "args": [
        [
          -2,
          3,
          -4
        ]
      ],
      "expected": 24
    },
    {
      "label": "all positive",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": 6
    },
    {
      "label": "single",
      "args": [
        [
          3
        ]
      ],
