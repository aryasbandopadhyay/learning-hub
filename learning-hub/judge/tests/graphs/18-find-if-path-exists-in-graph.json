{
  "id": "graphs/18-find-if-path-exists-in-graph",
  "cases": [
    {
      "label": "path exists",
      "args": [
        3,
        [
          [
            0,
            1
          ],
          [
            1,
            2
          ]
        ],
        0,
        2
      ],
      "expected": true
    },
    {
      "label": "no path",
      "args": [
        3,
        [
          [
            0,
            1
          ]
        ],
        0,
        2
      ],
      "expected": false
    },
    {
      "label": "same node",
      "args": [
        1,
        [],
        0,
        0
      ],
      "expected": true
    },
    {
      "label": "direct",
      "args": [
        2,
        [
          [
            0,
            1
          ]
        ],
        1,
        0
      ],
      "expected": true
    }
  ]
}