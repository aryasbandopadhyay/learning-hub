{
  "id": "strings/18-compare-version-numbers",
  "cases": [
    {
      "label": "leading zeros equal",
      "args": [
        "1.01",
        "1.001"
      ],
      "expected": 0
    },
    {
      "label": "trailing zero",
      "args": [
        "1.0",
        "1.0.0"
      ],
      "expected": 0
    },
    {
      "label": "greater",
      "args": [
        "0.1",
        "1.1"
      ],
      "expected": -1
    },
    {
      "label": "equal",
      "args": [
        "1.0",
        "1"
      ],
      "expected": 0
    },
    {
      "label": "less minor",
      "args": [
        "1.0.1",
        "1"
      ],
      "expected": 1
    }
  ]
}