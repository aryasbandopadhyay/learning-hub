{
  "id": "backtracking/05-permutations-ii",
  "cases": [
    {
      "label": "one dup",
      "args": [
        [
          1,
          1,
          2
        ]
      ],
      "expected": [
        [
          1,
          1,
          2
        ],
        [
          1,
          2,
          1
        ],
        [
          2,
          1,
          1
        ]
      ]
    },
    {
      "label": "all same",
      "args": [
        [
          2,
          2
        ]
      ],
      "expected": [
        [
          2,
          2
        ]
      ]
    },
    {
      "label": "single",
      "args": [
        [
          1
        ]
      ],
      "expected": [
        [
          1
        ]
      ]
    },
    {
      "label": "two distinct",
      "args": [
        [
          1,
          2
        ]
      ],
      "expected": [
        [
          1,
          2
        ],
        [
          2,
          1
        ]
      ]
    }
  ]
}