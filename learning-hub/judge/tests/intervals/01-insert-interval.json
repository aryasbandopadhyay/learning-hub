{
  "id": "intervals/01-insert-interval",
  "cases": [
    {
      "label": "example",
      "args": [
        [
          [
            1,
            3
          ],
          [
            6,
            9
          ]
        ],
        [
          2,
          5
        ]
      ],
      "expected": [
        [
          1,
          5
        ],
        [
          6,
          9
        ]
      ]
    },
    {
      "label": "empty list",
      "args": [
        [],
        [
          2,
          5
        ]
      ],
      "expected": [
        [
          2,
          5
        ]
      ]
    },
    {
      "label": "no overlap end",
      "args": [
        [
          [
            1,
            2
          ]
        ],
        [
          3,
          4
        ]
      ],
      "expected": [
        [
          1,
          2
        ],
        [
          3,
          4
        ]
      ]
    },
    {
      "label": "no overlap start",
      "args": [
        [
          [
            3,
            4
          ]
        ],
        [
          1,
          2
        ]
      ],
      "expected": [
        [
          1,
          2
        ],
        [
          3,
          4
        ]
      ]
    },
    {
      "label": "merge all",
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            4
          ],
          [
            5,
            6
          ]
        ],
        [
          0,
          7
        ]
      ],
      "expected": [
        [
          0,
          7
        ]
      ]
    },
    {
      "label": "touching",
      "args": [
        [
          [
            1,
            5
          ]
        ],
        [
          5,
          7
        ]
      ],
      "expected": [
        [
          1,
          7
        ]
      ]
    }
  ]
}