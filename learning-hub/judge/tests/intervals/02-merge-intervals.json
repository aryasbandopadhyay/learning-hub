{
  "id": "intervals/02-merge-intervals",
  "cases": [
    {
      "label": "example",
      "args": [
        [
          [
            1,
            3
          ],
          [
            2,
            6
          ],
          [
            8,
            10
          ],
          [
            15,
            18
          ]
        ]
      ],
      "expected": [
        [
          1,
          6
        ],
        [
          8,
          10
        ],
        [
          15,
          18
        ]
      ]
    },
    {
      "label": "single",
      "args": [
        [
          [
            1,
            4
          ]
        ]
      ],
      "expected": [
        [
          1,
          4
        ]
      ]
    },
    {
      "label": "all merge",
      "args": [
        [
          [
            1,
            4
          ],
          [
            2,
            5
          ],
          [
            3,
            6
          ]
        ]
      ],
      "expected": [
        [
          1,
          6
        ]
      ]
    },
    {
      "label": "no overlap",
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ]
      ],
      "expected": [
        [
          1,
          2
        ],
        [
          3,
          4
        ]
      ]
    },
    {
      "label": "touching merge",
      "args": [
        [
          [
            1,
            4
          ],
          [
            4,
            5
          ]
        ]
      ],
      "expected": [
        [
          1,
          5
        ]
      ]
    },
    {
      "label": "nested",
      "args": [
        [
          [
            1,
            10
          ],
          [
            2,
            3
          ]
        ]
      ],
      "expected": [
        [
          1,
          10
        ]
      ]
    }
  ]
}