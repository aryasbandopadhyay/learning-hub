{
  "id": "two-pointers/07-remove-duplicates-from-sorted-array",
  "note": "In-place; entry returns the new length k (compareMode exact on the returned int per this manifest). Inputs are sorted.",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          1,
          1,
          2
        ]
      ],
      "expected": 2
    },
    {
      "label": "all duplicates",
      "args": [
        [
          2,
          2,
          2,
          2
        ]
      ],
      "expected": 1
    },
    {
      "label": "no duplicates",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": 4
    },
    {
      "label": "single element",
      "args": [
        [
          5
        ]
      ],
      "expected": 1
    },
    {
      "label": "empty array",
      "args": [
        []
      ],
      "expected": 0
    },
    {
      "label": "negatives with duplicates",
      "args": [
        [
          -3,
          -3,
          -1,
          0,
          0,
          1
        ]
      ],
      "expected": 4
    },
    {
      "label": "two identical",
      "args": [
        [
          7,
          7
        ]
      ],
      "expected": 1
    }
  ]
}