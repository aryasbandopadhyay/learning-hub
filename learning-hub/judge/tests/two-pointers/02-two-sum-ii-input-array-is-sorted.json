{
  "id": "two-pointers/02-two-sum-ii-input-array-is-sorted",
  "note": "1-indexed answer; array sorted ascending; exactly one solution.",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          2,
          7,
          11,
          15
        ],
        9
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "label": "two elements",
      "args": [
        [
          1,
          2
        ],
        3
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "label": "answer at the two ends",
      "args": [
        [
          1,
          3,
          5,
          7,
          9
        ],
        10
      ],
      "expected": [
        1,
        5
      ]
    },
    {
      "label": "negatives to zero",
      "args": [
        [
          -5,
          -3,
          0,
          3,
          5
        ],
        0
      ],
      "expected": [
        1,
        5
      ]
    },
    {
      "label": "all negatives",
      "args": [
        [
          -8,
          -5,
          -2,
          -1
        ],
        -7
      ],
      "expected": [
        2,
        3
      ]
    },
    {
      "label": "duplicates form the pair",
      "args": [
        [
          3,
          3
        ],
        6
      ],
      "expected": [
        1,
        2
      ]
    }
  ]
}