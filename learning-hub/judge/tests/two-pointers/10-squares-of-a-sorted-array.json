{
  "id": "two-pointers/10-squares-of-a-sorted-array",
  "note": "Input sorted ascending (may include negatives); return squares sorted ascending.",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          -4,
          -1,
          0,
          3,
          10
        ]
      ],
      "expected": [
        0,
        1,
        9,
        16,
        100
      ]
    },
    {
      "label": "all negatives",
      "args": [
        [
          -7,
          -3,
          -1
        ]
      ],
      "expected": [
        1,
        9,
        49
      ]
    },
    {
      "label": "all non-negative",
      "args": [
        [
          0,
          2,
          5,
          8
        ]
      ],
      "expected": [
        0,
        4,
        25,
        64
      ]
    },
    {
      "label": "single element",
      "args": [
        [
          -5
        ]
      ],
      "expected": [
        25
      ]
    },
    {
      "label": "symmetric around zero",
      "args": [
        [
          -3,
          -2,
          2,
          3
        ]
      ],
      "expected": [
        4,
        4,
        9,
        9
      ]
    },
    {
      "label": "contains zero",
      "args": [
        [
          -2,
          0,
          1
        ]
      ],
      "expected": [
        0,
        1,
        4
      ]
    },
    {
      "label": "duplicates",
      "args": [
        [
          -2,
          -2,
          2,
          2
        ]
      ],
      "expected": [
        4,
        4,
        4,
        4
      ]
    },
    {
      "label": "empty",
      "args": [
        []
      ],
      "expected": []
    }
  ]
}