{
  "id": "two-pointers/15-3sum-closest",
  "note": "Sum of the triplet closest to target.",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          -1,
          2,
          1,
          -4
        ],
        1
      ],
      "expected": 2
    },
    {
      "label": "all zeros",
      "args": [
        [
          0,
          0,
          0
        ],
        1
      ],
      "expected": 0
    },
    {
      "label": "exactly three elements",
      "args": [
        [
          1,
          1,
          1
        ],
        3
      ],
      "expected": 3
    },
    {
      "label": "negative target",
      "args": [
        [
          -3,
          -2,
          -5,
          3,
          -4
        ],
        -1
      ],
      "expected": -2
    },
    {
      "label": "large positives",
      "args": [
        [
          10,
          20,
          30,
          40
        ],
        45
      ],
      "expected": 60
    },
    {
      "label": "duplicates",
      "args": [
        [
          1,
          1,
          1,
          1
        ],
        5
      ],
      "expected": 3
    },
    {
      "label": "closest below target",
      "args": [
        [
          1,
          2,
          4,
          8,
          16
        ],
        10
      ],
      "expected": 11
    }
  ]
}