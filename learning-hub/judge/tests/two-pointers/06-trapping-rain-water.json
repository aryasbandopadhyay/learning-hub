{
  "id": "two-pointers/06-trapping-rain-water",
  "cases": [
    {
      "label": "classic example",
      "args": [
        [
          0,
          1,
          0,
          2,
          1,
          0,
          1,
          3,
          2,
          1,
          2,
          1
        ]
      ],
      "expected": 6
    },
    {
      "label": "second example",
      "args": [
        [
          4,
          2,
          0,
          3,
          2,
          5
        ]
      ],
      "expected": 9
    },
    {
      "label": "no water when monotonic increasing",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": 0
    },
    {
      "label": "no water when monotonic decreasing",
      "args": [
        [
          4,
          3,
          2,
          1
        ]
      ],
      "expected": 0
    },
    {
      "label": "single valley",
      "args": [
        [
          3,
          0,
          3
        ]
      ],
      "expected": 3
    },
    {
      "label": "flat traps nothing",
      "args": [
        [
          2,
          2,
          2
        ]
      ],
      "expected": 0
    },
    {
      "label": "empty",
      "args": [
        []
      ],
      "expected": 0
    },
    {
      "label": "plateau valley",
      "args": [
        [
          5,
          0,
          0,
          0,
          5
        ]
      ],
      "expected": 15
    }
  ]
}