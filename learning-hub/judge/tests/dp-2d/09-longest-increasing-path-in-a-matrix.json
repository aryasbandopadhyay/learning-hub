      "args": [
        [
          [
            1
          ]
        ]
      ],
      "expected": 1
    },
    {
      "label": "flat",
      "args": [
        [
          [
            1,
            1
          ],
          [
            1,
            1
          ]
        ]
      ],
      "expected": 1
    },
    {
      "label": "increasing row",
      "args": [
        [
          [
            1,
            2,
            3
          ]
        ]
      ],
      "expected": 3
    },
    {
      "label": "snake",
      "args": [
        [
          [
            3,
