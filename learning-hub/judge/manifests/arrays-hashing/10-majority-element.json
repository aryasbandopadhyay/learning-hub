  "solutions": {
    "naive": "class Solution:\n    def majorityElement(self, nums: list[int]) -> int:\n        for x in nums:\n            if sum(1 for y in nums if y == x) > len(nums) // 2:\n                return x\n        return nums[0]",
    "better": "class Solution:\n    def majorityElement(self, nums: list[int]) -> int:\n        return sorted(nums)[len(nums)//2]",
    "optimal": "class Solution:\n    def majorityElement(self, nums: list[int]) -> int:\n        cand = None\n        votes = 0\n        for x in nums:\n            if votes == 0:\n                cand = x\n            votes += 1 if x == cand else -1\n        return cand"
