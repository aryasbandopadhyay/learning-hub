    "naive": "class Solution:\n    def maxProfit(self, prices: list[int]) -> int:\n        best = 0\n        for b in range(len(prices)):\n            for s in range(b + 1, len(prices)):\n                best = max(best, prices[s] - prices[b])\n        return best",
    "better": "class Solution:\n    def maxProfit(self, prices: list[int]) -> int:\n        n = len(prices)\n        future = [0] * n\n        future[-1] = prices[-1]\n        for i in range(n-2, -1, -1):\n            future[i] = max(prices[i], future[i+1])\n        return max(future[i] - prices[i] for i in range(n))",
    "optimal": "class Solution:\n    def maxProfit(self, prices: list[int]) -> int:\n        low = prices[0]\n        best = 0\n        for p in prices[1:]:\n            best = max(best, p - low)\n            low = min(low, p)\n        return best"
