  "solutions": {
    "naive": "class Solution:\n    def groupAnagrams(self, strs: list[str]) -> list[list[str]]:\n        used = [False] * len(strs)\n        ans = []\n        for i, word in enumerate(strs):\n            if used[i]:\n                continue\n            key = sorted(word)\n            group = []\n            for j in range(i, len(strs)):\n                if not used[j] and sorted(strs[j]) == key:\n                    used[j] = True\n                    group.append(strs[j])\n            ans.append(group)\n        return ans",
    "better": "class Solution:\n    def groupAnagrams(self, strs: list[str]) -> list[list[str]]:\n        groups = {}\n        for word in strs:\n            key = ''.join(sorted(word))\n            groups.setdefault(key, []).append(word)\n        return list(groups.values())",
    "optimal": "class Solution:\n    def groupAnagrams(self, strs: list[str]) -> list[list[str]]:\n        groups = {}\n        for word in strs:\n            cnt = [0] * 26\n            for ch in word:\n                cnt[ord(ch) - ord('a')] += 1\n            groups.setdefault(tuple(cnt), []).append(word)\n        return list(groups.values())"
  },
