    "naive": "class Solution:\n    def findMaxLength(self, nums: list[int]) -> int:\n        best = 0\n        for l in range(len(nums)):\n            for r in range(l, len(nums)):\n                z = o = 0\n                for i in range(l, r + 1):\n                    if nums[i] == 0:\n                        z += 1\n                    else:\n                        o += 1\n                if z == o:\n                    best = max(best, r - l + 1)\n        return best",
    "better": "class Solution:\n    def findMaxLength(self, nums: list[int]) -> int:\n        best = 0\n        for l in range(len(nums)):\n            z = o = 0\n            for r in range(l, len(nums)):\n                if nums[r] == 0:\n                    z += 1\n                else:\n                    o += 1\n                if z == o:\n                    best = max(best, r - l + 1)\n        return best",
    "optimal": "class Solution:\n    def findMaxLength(self, nums: list[int]) -> int:\n        first = {0: -1}\n        bal = best = 0\n        for i, x in enumerate(nums):\n            bal += 1 if x == 1 else -1\n            if bal in first:\n                best = max(best, i - first[bal])\n            else:\n                first[bal] = i\n        return best"
