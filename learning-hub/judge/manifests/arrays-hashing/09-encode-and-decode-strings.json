  "id": "arrays-hashing/09-encode-and-decode-strings",
  "title": "Encode and Decode Strings",
  "difficulty": "Medium",
  "topic": "arrays-hashing",
  "solutions": {
    "naive": "class Solution:\n    def encode(self, strs: list[str]) -> str:\n        return '|'.join(strs)\n\n    def decode(self, s: str) -> list[str]:\n        if s == '':\n            return ['']\n        return s.split('|')",
    "better": "class Solution:\n    def encode(self, strs: list[str]) -> str:\n        return '|'.join(w.replace('\\\\', '\\\\\\\\').replace('|', '\\\\|') for w in strs)\n\n    def decode(self, s: str) -> list[str]:\n        ans, cur, esc = [], [], False\n        for ch in s:\n            if esc:\n                cur.append(ch); esc = False\n            elif ch == '\\\\':\n                esc = True\n            elif ch == '|':\n                ans.append(''.join(cur)); cur = []\n            else:\n                cur.append(ch)\n        ans.append(''.join(cur))\n        return ans",
    "optimal": "class Solution:\n    def encode(self, strs: list[str]) -> str:\n        return ''.join(str(len(w)) + '#' + w for w in strs)\n\n    def decode(self, s: str) -> list[str]:\n        ans = []\n        i = 0\n        while i < len(s):\n            j = i\n            while s[j] != '#':\n                j += 1\n            length = int(s[i:j])\n            start = j + 1\n            ans.append(s[start:start+length])\n            i = start + length\n        return ans"
  },
