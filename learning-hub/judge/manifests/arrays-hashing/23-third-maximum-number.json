    "naive": "class Solution:\n    def thirdMax(self, nums: list[int]) -> int:\n        first = max(nums)\n        prev = None\n        cur = first\n        for _ in range(3):\n            cand = None\n            for x in nums:\n                if (prev is None or x < prev) and (cand is None or x > cand):\n                    cand = x\n            if cand is None:\n                return first\n            cur = prev = cand\n        return cur",
    "better": "class Solution:\n    def thirdMax(self, nums: list[int]) -> int:\n        vals = sorted(set(nums))\n        return vals[-3] if len(vals) >= 3 else vals[-1]",
    "optimal": "class Solution:\n    def thirdMax(self, nums: list[int]) -> int:\n        a = b = c = None\n        for x in nums:\n            if x == a or x == b or x == c:\n                continue\n            if a is None or x > a:\n                a, b, c = x, a, b\n            elif b is None or x > b:\n                b, c = x, b\n            elif c is None or x > c:\n                c = x\n        return c if c is not None else a"
