  "solutions": {
    "naive": "class Solution:\n    def containsDuplicate(self, nums: list[int]) -> bool:\n        for i in range(len(nums)):\n            for j in range(i + 1, len(nums)):\n                if nums[i] == nums[j]:\n                    return True\n        return False",
    "better": "class Solution:\n    def containsDuplicate(self, nums: list[int]) -> bool:\n        arr = sorted(nums)\n        for i in range(1, len(arr)):\n            if arr[i] == arr[i - 1]:\n                return True\n        return False",
    "optimal": "class Solution:\n    def containsDuplicate(self, nums: list[int]) -> bool:\n        seen = set()\n        for x in nums:\n            if x in seen:\n                return True\n            seen.add(x)\n        return False"
