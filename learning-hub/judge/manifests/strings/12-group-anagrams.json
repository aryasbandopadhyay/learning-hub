  "id": "strings/12-group-anagrams",
  "title": "Group Anagrams",
  "difficulty": "Medium",
  "topic": "strings",
  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def groupAnagrams(self, strs: List[str]) -> List[List[str]]:\n        groups = []\n        for word in strs:\n            placed = False\n            for group in groups:\n                if sorted(word) == sorted(group[0]):\n                    group.append(word)\n                    placed = True\n                    break\n            if not placed:\n                groups.append([word])\n        return groups",
    "better": "from collections import defaultdict\nfrom typing import List\n\nclass Solution:\n    def groupAnagrams(self, strs: List[str]) -> List[List[str]]:\n        groups = defaultdict(list)\n        for word in strs:\n            key = ''.join(sorted(word))\n            groups[key].append(word)\n        return list(groups.values())",
    "optimal": "from collections import defaultdict\nfrom typing import List\n\nclass Solution:\n    def groupAnagrams(self, strs: List[str]) -> List[List[str]]:\n        groups = defaultdict(list)\n        for word in strs:\n            counts = [0] * 26\n            for ch in word:\n                counts[ord(ch) - ord('a')] += 1\n            groups[tuple(counts)].append(word)\n        return list(groups.values())"
  },
