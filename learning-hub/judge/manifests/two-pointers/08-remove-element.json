  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def removeElement(self, nums: List[int], val: int) -> int:\n        kept = [x for x in nums if x != val]\n        for i, x in enumerate(kept):\n            nums[i] = x\n        return len(kept)",
    "better": "from typing import List\n\nclass Solution:\n    def removeElement(self, nums: List[int], val: int) -> int:\n        write = 0\n        for read in range(len(nums)):\n            if nums[read] != val:\n                nums[write] = nums[read]\n                write += 1\n        return write",
    "optimal": "from typing import List\n\nclass Solution:\n    def removeElement(self, nums: List[int], val: int) -> int:\n        i, n = 0, len(nums)\n        while i < n:\n            if nums[i] == val:\n                nums[i] = nums[n - 1]\n                n -= 1\n                # Do not increment i; the swapped value must be checked.\n            else:\n                i += 1\n        return n"
  },
