  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def reverseString(self, s: List[str]) -> None:\n        reversed_copy = s[::-1]\n        for i, ch in enumerate(reversed_copy):\n            s[i] = ch",
    "better": "from typing import List\n\nclass Solution:\n    def reverseString(self, s: List[str]) -> None:\n        # list.reverse mutates the original list and returns None.\n        s.reverse()",
    "optimal": "from typing import List\n\nclass Solution:\n    def reverseString(self, s: List[str]) -> None:\n        left, right = 0, len(s) - 1\n        while left < right:\n            s[left], s[right] = s[right], s[left]\n            left += 1\n            right -= 1"
  },
