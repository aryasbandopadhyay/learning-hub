  "solutions": {
    "naive": "class Solution:\n    def nextGreaterElements(self, nums: list[int]) -> list[int]:\n        n = len(nums)\n        ans = [-1] * n\n        for i in range(n):\n            for step in range(1, n):\n                j = (i + step) % n\n                if nums[j] > nums[i]:\n                    ans[i] = nums[j]\n                    break\n        return ans",
    "better": "class Solution:\n    def nextGreaterElements(self, nums: list[int]) -> list[int]:\n        n = len(nums)\n        ans = [-1] * n\n        stack = []\n        for i in range(2 * n):\n            idx = i % n\n            while stack and nums[idx] > nums[stack[-1]]:\n                ans[stack.pop()] = nums[idx]\n            # Push each original index once to avoid duplicate work.\n            if i < n:\n                stack.append(idx)\n        return ans",
    "optimal": "class Solution:\n    def nextGreaterElements(self, nums: list[int]) -> list[int]:\n        n = len(nums)\n        ans = [-1] * n\n        stack = []\n        for i in range(2 * n - 1, -1, -1):\n            x = nums[i % n]\n            while stack and stack[-1] <= x:\n                stack.pop()\n            if i < n and stack:\n                ans[i] = stack[-1]\n            stack.append(x)\n        return ans"
  },
