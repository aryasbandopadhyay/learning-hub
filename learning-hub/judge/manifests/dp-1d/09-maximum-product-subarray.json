  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def maxProduct(self, nums: List[int]) -> int:\n        best = nums[0]\n\n        def extend(start: int, end: int, product: int) -> None:\n            nonlocal best\n            if end == len(nums):\n                return\n            product *= nums[end]\n            best = max(best, product)\n            extend(start, end + 1, product)\n\n        for i in range(len(nums)):\n            extend(i, i, 1)\n        return best",
    "better": "from typing import List, Tuple\n\nclass Solution:\n    def maxProduct(self, nums: List[int]) -> int:\n        memo = {}\n\n        def ending(i: int) -> Tuple[int, int]:\n            if i == 0:\n                return nums[0], nums[0]\n            if i not in memo:\n                prev_max, prev_min = ending(i - 1)\n                x = nums[i]\n                memo[i] = (max(x, x * prev_max, x * prev_min),\n                           min(x, x * prev_max, x * prev_min))\n            return memo[i]\n\n        return max(ending(i)[0] for i in range(len(nums)))",
    "optimal": "from typing import List\n\nclass Solution:\n    def maxProduct(self, nums: List[int]) -> int:\n        cur_max = cur_min = ans = nums[0]\n        for x in nums[1:]:\n            a, b = x * cur_max, x * cur_min\n            cur_max = max(x, a, b)\n            cur_min = min(x, a, b)\n            ans = max(ans, cur_max)\n        return ans"
  },
