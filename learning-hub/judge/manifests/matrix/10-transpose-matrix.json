  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def transpose(self, matrix: List[List[int]]) -> List[List[int]]:\n        m, n = len(matrix), len(matrix[0])\n        ans = [[0] * m for _ in range(n)]\n        for r in range(m):\n            for c in range(n):\n                ans[c][r] = matrix[r][c]\n        return ans",
    "better": "from typing import List\n\nclass Solution:\n    def transpose(self, matrix: List[List[int]]) -> List[List[int]]:\n        m, n = len(matrix), len(matrix[0])\n        ans = []\n        for c in range(n):\n            row = []\n            for r in range(m):\n                row.append(matrix[r][c])\n            ans.append(row)\n        return ans",
    "optimal": "from typing import List\n\nclass Solution:\n    def transpose(self, matrix: List[List[int]]) -> List[List[int]]:\n        return [list(col) for col in zip(*matrix)]"
