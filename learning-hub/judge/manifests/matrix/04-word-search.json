  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def exist(self, board: List[List[str]], word: str) -> bool:\n        m, n = len(board), len(board[0])\n\n        def dfs(r: int, c: int, i: int, used: set[tuple[int, int]]) -> bool:\n            if i == len(word):\n                return True\n            if not (0 <= r < m and 0 <= c < n):\n                return False\n            if (r, c) in used or board[r][c] != word[i]:\n                return False\n\n            used.add((r, c))\n            found = (\n                dfs(r + 1, c, i + 1, used) or\n                dfs(r - 1, c, i + 1, used) or\n                dfs(r, c + 1, i + 1, used) or\n                dfs(r, c - 1, i + 1, used)\n            )\n            used.remove((r, c))\n            return found\n\n        return any(dfs(r, c, 0, set()) for r in range(m) for c in range(n))",
    "better": "from collections import Counter\nfrom typing import List\n\nclass Solution:\n    def exist(self, board: List[List[str]], word: str) -> bool:\n        counts = Counter(ch for row in board for ch in row)\n        need = Counter(word)\n        if any(counts[ch] < need[ch] for ch in need):\n            return False\n\n        m, n = len(board), len(board[0])\n        seen = [[False] * n for _ in range(m)]\n\n        def dfs(r: int, c: int, i: int) -> bool:\n            if i == len(word):\n                return True\n            if not (0 <= r < m and 0 <= c < n):\n                return False\n            if seen[r][c] or board[r][c] != word[i]:\n                return False\n            seen[r][c] = True\n            ok = any(dfs(r + dr, c + dc, i + 1) for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)))\n            seen[r][c] = False\n            return ok\n\n        return any(dfs(r, c, 0) for r in range(m) for c in range(n))",
    "optimal": "from collections import Counter\nfrom typing import List\n\nclass Solution:\n    def exist(self, board: List[List[str]], word: str) -> bool:\n        m, n = len(board), len(board[0])\n        counts = Counter(ch for row in board for ch in row)\n        need = Counter(word)\n        if any(counts[ch] < need[ch] for ch in need):\n            return False\n        if counts[word[-1]] < counts[word[0]]:\n            word = word[::-1]\n\n        def dfs(r: int, c: int, i: int) -> bool:\n            if i == len(word):\n                return True\n            if not (0 <= r < m and 0 <= c < n) or board[r][c] != word[i]:\n                return False\n\n            saved = board[r][c]\n            board[r][c] = \"#\"  # Temporary sentinel prevents reuse.\n            ok = (\n                dfs(r + 1, c, i + 1) or\n                dfs(r - 1, c, i + 1) or\n                dfs(r, c + 1, i + 1) or\n                dfs(r, c - 1, i + 1)\n            )\n            board[r][c] = saved\n            return ok\n\n        return any(board[r][c] == word[0] and dfs(r, c, 0) for r in range(m) for c in range(n))"
  },
