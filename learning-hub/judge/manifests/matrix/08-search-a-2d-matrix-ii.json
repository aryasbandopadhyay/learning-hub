  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:\n        return any(value == target for row in matrix for value in row)",
    "better": "from typing import List\n\nclass Solution:\n    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:\n        for row in matrix:\n            if row[0] <= target <= row[-1]:\n                left, right = 0, len(row) - 1\n                while left <= right:\n                    mid = (left + right) // 2\n                    if row[mid] == target:\n                        return True\n                    if row[mid] < target:\n                        left = mid + 1\n                    else:\n                        right = mid - 1\n        return False",
    "optimal": "from typing import List\n\nclass Solution:\n    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:\n        m, n = len(matrix), len(matrix[0])\n        r, c = 0, n - 1\n        while r < m and c >= 0:\n            value = matrix[r][c]\n            if value == target:\n                return True\n            if value > target:\n                c -= 1  # Current column below is even larger.\n            else:\n                r += 1  # Current row to the left is even smaller.\n        return False"
  },
