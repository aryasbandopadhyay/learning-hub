  "id": "matrix/07-search-a-2d-matrix",
  "title": "Search a 2D Matrix",
  "difficulty": "Medium",
  "topic": "matrix",
  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:\n        for row in matrix:\n            for value in row:\n                if value == target:\n                    return True\n        return False",
    "better": "from bisect import bisect_right\nfrom typing import List\n\nclass Solution:\n    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:\n        first_values = [row[0] for row in matrix]\n        row = bisect_right(first_values, target) - 1\n        if row < 0:\n            return False\n\n        nums = matrix[row]\n        left, right = 0, len(nums) - 1\n        while left <= right:\n            mid = (left + right) // 2\n            if nums[mid] == target:\n                return True\n            if nums[mid] < target:\n                left = mid + 1\n            else:\n                right = mid - 1\n        return False",
    "optimal": "from typing import List\n\nclass Solution:\n    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:\n        m, n = len(matrix), len(matrix[0])\n        left, right = 0, m * n - 1\n        while left <= right:\n            mid = (left + right) // 2\n            r, c = divmod(mid, n)\n            value = matrix[r][c]\n            if value == target:\n                return True\n            if value < target:\n                left = mid + 1\n            else:\n                right = mid - 1\n        return False"
  },
