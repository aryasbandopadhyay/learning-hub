  "solutions": {
    "naive": "class Solution:\n    def maxFrequency(self, nums: list[int], k: int) -> int:\n        nums = sorted(nums)\n        best = 1\n        n = len(nums)\n        for right in range(n):\n            cost = 0\n            count = 1\n            for left in range(right - 1, -1, -1):\n                cost += nums[right] - nums[left]\n                if cost > k:\n                    break\n                count += 1\n            best = max(best, count)\n        return best",
    "better": "class Solution:\n    def maxFrequency(self, nums: list[int], k: int) -> int:\n        nums = sorted(nums)\n        prefix = [0]\n        for x in nums:\n            prefix.append(prefix[-1] + x)\n        best = 1\n        for right, target in enumerate(nums):\n            lo, hi = 0, right\n            while lo < hi:\n                mid = (lo + hi) // 2\n                total = prefix[right + 1] - prefix[mid]\n                cost = target * (right - mid + 1) - total\n                if cost <= k:\n                    hi = mid\n                else:\n                    lo = mid + 1\n            best = max(best, right - lo + 1)\n        return best",
    "optimal": "class Solution:\n    def maxFrequency(self, nums: list[int], k: int) -> int:\n        nums = sorted(nums)\n        left = 0\n        total = 0\n        best = 1\n        for right, value in enumerate(nums):\n            total += value\n            while value * (right - left + 1) - total > k:\n                total -= nums[left]\n                left += 1\n            best = max(best, right - left + 1)\n        return best"
  },
