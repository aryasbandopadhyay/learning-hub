  "solutions": {
    "naive": "class Solution:\n    def minSubarray(self, nums: list[int], p: int) -> int:\n        total = sum(nums)\n        if total % p == 0:\n            return 0\n        n = len(nums)\n        best = n\n        for i in range(n):\n            removed = 0\n            for j in range(i, n):\n                removed += nums[j]\n                if j - i + 1 < n and (total - removed) % p == 0:\n                    best = min(best, j - i + 1)\n        return -1 if best == n else best",
    "better": "class Solution:\n    def minSubarray(self, nums: list[int], p: int) -> int:\n        need = sum(nums) % p\n        if need == 0:\n            return 0\n        prefix = [0]\n        for x in nums:\n            prefix.append((prefix[-1] + x) % p)\n        n = len(nums)\n        best = n\n        for i in range(n):\n            for j in range(i + 1, n + 1):\n                if j - i < n and (prefix[j] - prefix[i]) % p == need:\n                    best = min(best, j - i)\n        return -1 if best == n else best",
    "optimal": "class Solution:\n    def minSubarray(self, nums: list[int], p: int) -> int:\n        need = sum(nums) % p\n        if need == 0:\n            return 0\n        seen = {0: -1}\n        cur = 0\n        best = len(nums)\n        for i, x in enumerate(nums):\n            cur = (cur + x) % p\n            want = (cur - need) % p\n            if want in seen:\n                best = min(best, i - seen[want])\n            seen[cur] = i\n        return -1 if best == len(nums) else best"
  },
