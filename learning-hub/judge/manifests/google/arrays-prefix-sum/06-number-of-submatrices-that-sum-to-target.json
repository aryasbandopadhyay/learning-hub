  "solutions": {
    "naive": "class Solution:\n    def numSubmatrixSumTarget(self, matrix: list[list[int]], target: int) -> int:\n        m, n = len(matrix), len(matrix[0])\n        pref = [[0] * (n + 1) for _ in range(m + 1)]\n        for i in range(m):\n            for j in range(n):\n                pref[i + 1][j + 1] = matrix[i][j] + pref[i][j + 1] + pref[i + 1][j] - pref[i][j]\n        ans = 0\n        for r1 in range(m):\n            for c1 in range(n):\n                for r2 in range(r1, m):\n                    for c2 in range(c1, n):\n                        total = pref[r2 + 1][c2 + 1] - pref[r1][c2 + 1] - pref[r2 + 1][c1] + pref[r1][c1]\n                        if total == target:\n                            ans += 1\n        return ans",
    "better": "class Solution:\n    def numSubmatrixSumTarget(self, matrix: list[list[int]], target: int) -> int:\n        m, n = len(matrix), len(matrix[0])\n        ans = 0\n        for top in range(m):\n            col = [0] * n\n            for bottom in range(top, m):\n                for c in range(n):\n                    col[c] += matrix[bottom][c]\n                for left in range(n):\n                    total = 0\n                    for right in range(left, n):\n                        total += col[right]\n                        if total == target:\n                            ans += 1\n        return ans",
    "optimal": "class Solution:\n    def numSubmatrixSumTarget(self, matrix: list[list[int]], target: int) -> int:\n        m, n = len(matrix), len(matrix[0])\n        ans = 0\n        for top in range(m):\n            col = [0] * n\n            for bottom in range(top, m):\n                for c in range(n):\n                    col[c] += matrix[bottom][c]\n                freq = {0: 1}\n                total = 0\n                for x in col:\n                    total += x\n                    ans += freq.get(total - target, 0)\n                    freq[total] = freq.get(total, 0) + 1\n        return ans"
  },
