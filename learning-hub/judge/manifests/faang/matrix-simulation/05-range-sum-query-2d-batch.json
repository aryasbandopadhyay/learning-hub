  "id": "faang/matrix-simulation/05-range-sum-query-2d-batch",
  "title": "Range Sum Query 2D Batch",
  "difficulty": "Medium",
  "topic": "faang/matrix-simulation",
  "solutions": {
    "naive": "class Solution:\n    def rangeSum2D(self, matrix: list[list[int]], queries: list[list[int]]) -> list[int]:\n        ans = []\n        for r1, c1, r2, c2 in queries:\n            total = 0\n            for r in range(r1, r2 + 1):\n                for c in range(c1, c2 + 1):\n                    total += matrix[r][c]\n            ans.append(total)\n        return ans",
