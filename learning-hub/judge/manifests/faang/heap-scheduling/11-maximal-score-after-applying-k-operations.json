  "solutions": {
    "naive": "class Solution:\n    def maxKelements(self, nums, k):\n        arr = nums[:]\n        score = 0\n        for _ in range(k):\n            arr.sort()\n            value = arr.pop()\n            score += value\n            arr.append((value + 2) // 3)\n        return score",
    "better": "class Solution:\n    def maxKelements(self, nums, k):\n        from bisect import insort\n        arr = sorted(-x for x in nums)\n        score = 0\n        for _ in range(k):\n            value = -arr.pop(0)\n            score += value\n            insort(arr, -((value + 2) // 3))\n        return score",
    "optimal": "class Solution:\n    def maxKelements(self, nums, k):\n        import heapq\n        heap = [-x for x in nums]\n        heapq.heapify(heap)\n        score = 0\n        for _ in range(k):\n            value = -heapq.heappop(heap)\n            score += value\n            heapq.heappush(heap, -((value + 2) // 3))\n        return score"
  },
