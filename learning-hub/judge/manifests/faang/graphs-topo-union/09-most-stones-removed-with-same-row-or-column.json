  "solutions": {
    "naive": "class Solution:\n    def removeStones(self, stones: list[list[int]]) -> int:\n        n = len(stones)\n        adj = [[] for _ in range(n)]\n        for i in range(n):\n            for j in range(i + 1, n):\n                if stones[i][0] == stones[j][0] or stones[i][1] == stones[j][1]:\n                    adj[i].append(j); adj[j].append(i)\n        seen = [False] * n; comps = 0\n        for i in range(n):\n            if not seen[i]:\n                comps += 1; seen[i] = True; stack = [i]\n                while stack:\n                    u = stack.pop()\n                    for v in adj[u]:\n                        if not seen[v]:\n                            seen[v] = True; stack.append(v)\n        return n - comps",
    "better": "class Solution:\n    def removeStones(self, stones: list[list[int]]) -> int:\n        from collections import defaultdict\n        rows = defaultdict(list); cols = defaultdict(list)\n        for i, (r, c) in enumerate(stones):\n            rows[r].append(i); cols[c].append(i)\n        seen = [False] * len(stones); comps = 0\n        for i in range(len(stones)):\n            if seen[i]:\n                continue\n            comps += 1; seen[i] = True; stack = [i]\n            while stack:\n                u = stack.pop(); r, c = stones[u]\n                for v in rows[r] + cols[c]:\n                    if not seen[v]:\n                        seen[v] = True; stack.append(v)\n        return len(stones) - comps",
    "optimal": "class Solution:\n    def removeStones(self, stones: list[list[int]]) -> int:\n        parent = {}\n        def find(x):\n            if x not in parent:\n                parent[x] = x\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]; x = parent[x]\n            return x\n        def union(a, b):\n            ra, rb = find(a), find(b)\n            if ra != rb:\n                parent[rb] = ra\n        for r, c in stones:\n            union(('r', r), ('c', c))\n        roots = {find(('r', r)) for r, c in stones}\n        return len(stones) - len(roots)"
