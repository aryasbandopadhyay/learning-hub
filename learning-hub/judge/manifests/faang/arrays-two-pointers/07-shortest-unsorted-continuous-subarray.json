  "solutions": {
    "naive": "class Solution:\n    def findUnsortedSubarray(self, nums: list[int]) -> int:\n        n=len(nums)\n        if nums == sorted(nums): return 0\n        best=n\n        for l in range(n):\n            for r in range(l,n):\n                a=nums[:l]+sorted(nums[l:r+1])+nums[r+1:]\n                if a == sorted(a): best=min(best,r-l+1)\n        return best",
    "better": "class Solution:\n    def findUnsortedSubarray(self, nums: list[int]) -> int:\n        s=sorted(nums)\n        l,r=0,len(nums)-1\n        while l < len(nums) and nums[l] == s[l]: l += 1\n        while r > l and nums[r] == s[r]: r -= 1\n        return 0 if l == len(nums) else r-l+1",
    "optimal": "class Solution:\n    def findUnsortedSubarray(self, nums: list[int]) -> int:\n        right=-1; mx=-10**20\n        for i,x in enumerate(nums):\n            if x < mx: right=i\n            else: mx=x\n        left=len(nums); mn=10**20\n        for i in range(len(nums)-1,-1,-1):\n            if nums[i] > mn: left=i\n            else: mn=nums[i]\n        return 0 if right == -1 else right-left+1"
