  "solutions": {
    "naive": "class Solution:\n    def removeDuplicates(self, nums: list[int]) -> list[int]:\n        counts={}\n        for x in nums: counts[x]=counts.get(x,0)+1\n        out=[]\n        for x in sorted(counts): out.extend([x]*min(2,counts[x]))\n        nums[:len(out)] = out\n        return nums[:len(out)]",
    "better": "class Solution:\n    def removeDuplicates(self, nums: list[int]) -> list[int]:\n        out=[]; i=0\n        while i < len(nums):\n            j=i\n            while j < len(nums) and nums[j] == nums[i]: j += 1\n            out.extend([nums[i]] * min(2, j-i)); i=j\n        nums[:len(out)] = out\n        return nums[:len(out)]",
    "optimal": "class Solution:\n    def removeDuplicates(self, nums: list[int]) -> list[int]:\n        write=0\n        for x in nums:\n            if write < 2 or x != nums[write-2]:\n                nums[write] = x; write += 1\n        return nums[:write]"
  },
