  "solutions": {
    "naive": "class Solution:\n    def minCapability(self, nums, k):\n        def can(cap):\n            taken = 0; i = 0\n            while i < len(nums):\n                if nums[i] <= cap:\n                    taken += 1; i += 2\n                else:\n                    i += 1\n            return taken >= k\n        for cap in range(min(nums), max(nums)+1):\n            if can(cap): return cap\n        return max(nums)",
    "better": "class Solution:\n    def minCapability(self, nums, k):\n        def can(cap):\n            taken = 0; i = 0\n            while i < len(nums):\n                if nums[i] <= cap:\n                    taken += 1; i += 2\n                else:\n                    i += 1\n            if taken == k: return True\n            return False\n        vals=sorted(set(nums)); lo,hi,ans=0,len(vals)-1,vals[-1]\n        while lo<=hi:\n            mid=(lo+hi)//2\n            if can(vals[mid]): ans=vals[mid]; hi=mid-1\n            else: lo=mid+1\n        return ans",
    "optimal": "class Solution:\n    def minCapability(self, nums, k):\n        def can(cap):\n            taken = 0; i = 0\n            while i < len(nums):\n                if nums[i] <= cap:\n                    taken += 1; i += 2\n                else:\n                    i += 1\n            if taken == k: return True\n            return False\n        lo,hi=min(nums),max(nums)\n        while lo<hi:\n            mid=(lo+hi)//2\n            if can(mid): hi=mid\n            else: lo=mid+1\n        return lo"
  },
