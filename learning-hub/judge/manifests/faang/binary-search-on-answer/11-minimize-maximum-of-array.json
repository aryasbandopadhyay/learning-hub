    "naive": "class Solution:\n    def minimizeArrayValue(self, nums):\n        def can(bound):\n            prefix = 0\n            for i, x in enumerate(nums):\n                prefix += x\n                if prefix > (i + 1) * bound:\n                    return False\n            return True\n        for b in range(0,max(nums)+1):\n            if can(b): return b\n        return max(nums)",
    "better": "class Solution:\n    def minimizeArrayValue(self, nums):\n        def can(bound):\n            prefix = 0\n            for i, x in enumerate(nums):\n                prefix += x\n                if prefix > (i + 1) * bound:\n                    return False\n            return True\n        lo,hi,ans=0,max(nums),max(nums)\n        while lo<=hi:\n            mid=(lo+hi)//2\n            if can(mid): ans=mid; hi=mid-1\n            else: lo=mid+1\n        return ans",
    "optimal": "class Solution:\n    def minimizeArrayValue(self, nums):\n        prefix = ans = 0\n        for i, x in enumerate(nums):\n            prefix += x\n            ans = max(ans, (prefix + i) // (i + 1))\n        return ans"
