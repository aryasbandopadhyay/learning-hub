  "solutions": {
    "naive": "class Solution:\n    def numWays(self, words: list[str], target: str) -> int:\n        mod = 1000000007\n        width = len(words[0])\n        def dfs(pos, col):\n            if pos == len(target):\n                return 1\n            total = 0\n            for j in range(col, width):\n                for word in words:\n                    if word[j] == target[pos]:\n                        total += dfs(pos + 1, j + 1)\n            return total % mod\n        return dfs(0, 0)",
    "better": "class Solution:\n    def numWays(self, words, target):\n        from functools import lru_cache\n        mod = 1000000007\n        width = len(words[0])\n        counts = [[0] * 26 for _ in range(width)]\n        for word in words:\n            for j, ch in enumerate(word):\n                counts[j][ord(ch) - 97] += 1\n        @lru_cache(None)\n        def dfs(pos, col):\n            if pos == len(target):\n                return 1\n            if col == width:\n                return 0\n            skip = dfs(pos, col + 1)\n            use = counts[col][ord(target[pos]) - 97] * dfs(pos + 1, col + 1)\n            return (skip + use) % mod\n        return dfs(0, 0)",
    "optimal": "class Solution:\n    def numWays(self, words, target):\n        mod = 1000000007\n        dp = [0] * (len(target) + 1)\n        dp[0] = 1\n        for col in range(len(words[0])):\n            freq = [0] * 26\n            for word in words:\n                freq[ord(word[col]) - 97] += 1\n            for pos in range(len(target) - 1, -1, -1):\n                dp[pos + 1] = (dp[pos + 1] + dp[pos] * freq[ord(target[pos]) - 97]) % mod\n        return dp[len(target)]"
  },
