  "solutions": {
    "naive": "class Solution:\n    def validateStackSequences(self, pushed: list[int], popped: list[int]) -> bool:\n        n = len(pushed)\n        seen = set()\n        def dfs(i, j, stack):\n            state = (i, j, tuple(stack))\n            if state in seen:\n                return False\n            seen.add(state)\n            if j == n:\n                return True\n            if stack and stack[-1] == popped[j] and dfs(i, j + 1, stack[:-1]):\n                return True\n            if i < n and dfs(i + 1, j, stack + [pushed[i]]):\n                return True\n            return False\n        return dfs(0, 0, [])",
    "better": "class Solution:\n    def validateStackSequences(self, pushed: list[int], popped: list[int]) -> bool:\n        stack = []\n        j = 0\n        for x in pushed:\n            stack.append(x)\n            while stack and stack[-1] == popped[j]:\n                stack.pop()\n                j += 1\n        return j == len(popped)",
    "optimal": "class Solution:\n    def validateStackSequences(self, pushed: list[int], popped: list[int]) -> bool:\n        top = 0\n        j = 0\n        for x in pushed:\n            pushed[top] = x\n            top += 1\n            while top and pushed[top - 1] == popped[j]:\n                top -= 1\n                j += 1\n        return top == 0"
  },
