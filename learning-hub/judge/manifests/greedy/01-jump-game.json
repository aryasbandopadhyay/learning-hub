  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def canJump(self, nums: List[int]) -> bool:\n        n = len(nums)\n\n        def dfs(i: int) -> bool:\n            # Once we reach or cross the last index, the game is won.\n            if i >= n - 1:\n                return True\n            for step in range(1, nums[i] + 1):\n                if dfs(i + step):\n                    return True\n            return False\n\n        return dfs(0)",
    "better": "from functools import lru_cache\nfrom typing import List\n\nclass Solution:\n    def canJump(self, nums: List[int]) -> bool:\n        n = len(nums)\n\n        @lru_cache(None)\n        def good(i: int) -> bool:\n            if i >= n - 1:\n                return True\n            furthest = min(n - 1, i + nums[i])\n            for nxt in range(i + 1, furthest + 1):\n                if good(nxt):\n                    return True\n            return False\n\n        return good(0)",
    "optimal": "from typing import List\n\nclass Solution:\n    def canJump(self, nums: List[int]) -> bool:\n        farthest = 0\n        for i, jump in enumerate(nums):\n            if i > farthest:\n                return False\n            farthest = max(farthest, i + jump)\n            if farthest >= len(nums) - 1:\n                return True\n        return True"
  },
