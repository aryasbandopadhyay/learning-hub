  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def searchRange(self, nums: List[int], target: int) -> List[int]:\n        first = last = -1\n        for i, value in enumerate(nums):\n            if value == target:\n                if first == -1:\n                    first = i\n                last = i\n        return [first, last]",
    "better": "from bisect import bisect_left, bisect_right\nfrom typing import List\n\nclass Solution:\n    def searchRange(self, nums: List[int], target: int) -> List[int]:\n        left = bisect_left(nums, target)\n        right = bisect_right(nums, target) - 1\n        if left <= right:\n            return [left, right]\n        return [-1, -1]",
    "optimal": "from typing import List\n\nclass Solution:\n    def searchRange(self, nums: List[int], target: int) -> List[int]:\n        def lower_bound(value: int) -> int:\n            left, right = 0, len(nums)\n            while left < right:\n                mid = (left + right) // 2\n                if nums[mid] < value:\n                    left = mid + 1\n                else:\n                    right = mid\n            return left\n\n        first = lower_bound(target)\n        last_exclusive = lower_bound(target + 1)\n        if first == len(nums) or nums[first] != target:\n            return [-1, -1]\n        return [first, last_exclusive - 1]"
  },
