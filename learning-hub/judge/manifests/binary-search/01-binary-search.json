  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def search(self, nums: List[int], target: int) -> int:\n        # Linear scan checks each candidate directly.\n        for i, value in enumerate(nums):\n            if value == target:\n                return i\n        return -1",
    "better": "from typing import List\n\nclass Solution:\n    def search(self, nums: List[int], target: int) -> int:\n        def helper(left: int, right: int) -> int:\n            if left > right:\n                return -1\n            mid = left + (right - left) // 2\n            if nums[mid] == target:\n                return mid\n            if nums[mid] < target:\n                return helper(mid + 1, right)\n            return helper(left, mid - 1)\n\n        return helper(0, len(nums) - 1)",
    "optimal": "from typing import List\n\nclass Solution:\n    def search(self, nums: List[int], target: int) -> int:\n        left, right = 0, len(nums) - 1\n        while left <= right:\n            mid = left + (right - left) // 2\n            if nums[mid] == target:\n                return mid\n            if nums[mid] < target:\n                left = mid + 1\n            else:\n                right = mid - 1\n        return -1"
  },
