  "id": "graphs/07-surrounded-regions",
  "title": "Surrounded Regions",
  "difficulty": "Medium",
  "topic": "graphs",
  "solutions": {
    "naive": "from typing import List\nfrom collections import deque\n\nclass Solution:\n    def solve(self, board: List[List[str]]) -> None:\n        # Mark escaping O cells from the border.\n        if not board or not board[0]: return\n        m, n = len(board), len(board[0])\n        q = deque()\n        for r in range(m):\n            for c in (0, n-1):\n                if board[r][c] == \"O\": board[r][c] = \"E\"; q.append((r,c))\n        for c in range(n):\n            for r in (0, m-1):\n                if board[r][c] == \"O\": board[r][c] = \"E\"; q.append((r,c))\n        while q:\n            r, c = q.popleft()\n            for dr, dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < m and 0 <= nc < n and board[nr][nc] == \"O\":\n                    board[nr][nc] = \"E\"; q.append((nr,nc))\n        for r in range(m):\n            for c in range(n):\n                board[r][c] = \"O\" if board[r][c] == \"E\" else \"X\"",
    "better": "from typing import List\nfrom collections import deque\n\nclass Solution:\n    def solve(self, board: List[List[str]]) -> None:\n        # Mark escaping O cells from the border.\n        if not board or not board[0]: return\n        m, n = len(board), len(board[0])\n        q = deque()\n        for r in range(m):\n            for c in (0, n-1):\n                if board[r][c] == \"O\": board[r][c] = \"E\"; q.append((r,c))\n        for c in range(n):\n            for r in (0, m-1):\n                if board[r][c] == \"O\": board[r][c] = \"E\"; q.append((r,c))\n        while q:\n            r, c = q.popleft()\n            for dr, dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < m and 0 <= nc < n and board[nr][nc] == \"O\":\n                    board[nr][nc] = \"E\"; q.append((nr,nc))\n        for r in range(m):\n            for c in range(n):\n                board[r][c] = \"O\" if board[r][c] == \"E\" else \"X\"",
    "optimal": "from typing import List\nfrom collections import deque\n\nclass Solution:\n    def solve(self, board: List[List[str]]) -> None:\n        # Mark escaping O cells from the border.\n        if not board or not board[0]: return\n        m, n = len(board), len(board[0])\n        q = deque()\n        for r in range(m):\n            for c in (0, n-1):\n                if board[r][c] == \"O\": board[r][c] = \"E\"; q.append((r,c))\n        for c in range(n):\n            for r in (0, m-1):\n                if board[r][c] == \"O\": board[r][c] = \"E\"; q.append((r,c))\n        while q:\n            r, c = q.popleft()\n            for dr, dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < m and 0 <= nc < n and board[nr][nc] == \"O\":\n                    board[nr][nc] = \"E\"; q.append((nr,nc))\n        for r in range(m):\n            for c in range(n):\n                board[r][c] = \"O\" if board[r][c] == \"E\" else \"X\""
