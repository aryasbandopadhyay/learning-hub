  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def validPath(self, n: int, edges: List[List[int]], source: int, destination: int) -> bool:\n        # Union all edges, then compare roots.\n        parent = list(range(n))\n        def find(x):\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]; x = parent[x]\n            return x\n        for a, b in edges:\n            parent[find(a)] = find(b)\n        return find(source) == find(destination)",
    "better": "from typing import List\n\nclass Solution:\n    def validPath(self, n: int, edges: List[List[int]], source: int, destination: int) -> bool:\n        # Union all edges, then compare roots.\n        parent = list(range(n))\n        def find(x):\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]; x = parent[x]\n            return x\n        for a, b in edges:\n            parent[find(a)] = find(b)\n        return find(source) == find(destination)",
