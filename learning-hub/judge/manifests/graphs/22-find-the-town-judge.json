  "solutions": {
    "naive": "from typing import List\n\nclass Solution:\n    def findJudge(self, n: int, trust: List[List[int]]) -> int:\n        # Trusting subtracts one; being trusted adds one.\n        score = [0] * (n + 1)\n        for a, b in trust:\n            score[a] -= 1; score[b] += 1\n        for i in range(1, n + 1):\n            if score[i] == n - 1:\n                return i\n        return -1",
